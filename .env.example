# 1. Discord Bot Configuration
TOKEN=your_main_discord_bot_token_here
CLIENT_ID=your_main_discord_client_id_here
PREFIX=>
DEV_IDS=your_discord_user_id_here

# 2. Dual MySQL Databases
DATABASE_URL=mysql://root:your_password@127.0.0.1:3306/aris_db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aris_db
DB_CONNECTION_LIMIT=10
DB_SSL=false

# 3. Runtime & Rate Limit Configuration
NODE_ENV=production
PORT=10000
REGISTER_SLASH_COMMANDS=true
GLOBAL_COOLDOWN_MS=2000
FRAME_TIMEOUT_MS=300000
COOLDOWN_DELETE_MS=30000
